<Window x:Class="MasterFloorShurkov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterFloorShurkov"
        mc:Ignorable="d"
            Title="Мастер пол" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="5" Orientation="Horizontal">
            <Image Source="Мастер пол.png" Margin="20,0,0,0" Width="50" Height="50" HorizontalAlignment="Left"/>
            <TextBlock Text="Список партнеров" VerticalAlignment="Center" FontSize="20" Margin="20,0,0,0"/>
            <Button Content="Добавить партнера" Height="30" Width="150" HorizontalAlignment="Right" Margin="350,0,0,0" Background="#67BA80" Click="Add_Click"/>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Partners}" SelectedItem="{Binding SelectedPartner, Mode=TwoWay}" SelectionChanged="EditData_SelectionChanged" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Grid Background="#F4E8D3" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="15">
                            <TextBlock FontSize="18">
                            <Run Text="{Binding TypeName}"/>
                            <Run Text="|"/>
                            <Run Text="{Binding NameOrganization}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Director}" />
                            <TextBlock Text="{Binding PhoneNumber}"/>
                            <TextBlock>
                            <Run Text="Рейтинг: "/>
                            <Run Text="{Binding Rating}"/>
                            </TextBlock>


                        </StackPanel>
                        <TextBlock Text="{Binding Discount}" Grid.Column="1" VerticalAlignment="Top" Margin="0,20,50,20" FontSize="18" HorizontalAlignment="Right"/>
                    </Grid>

                </DataTemplate>

            </ItemsControl.ItemTemplate>
        </ListView>


    </Grid>
</Window>
